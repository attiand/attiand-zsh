#!/bin/bash -e


usage() {
   echo "Push to Gerrit"
   echo
   echo "Syntax: git review [OPTIONS] [BRANCH]"
   echo
   echo "OPTIONS:"
   echo "-a     Auto submit (push to Gerrit and submit the change)"
   echo "-h     Print this help"
   echo
   echo "BRANCH - The branch to push to, use current checked-out branch if not specified"
   echo
   echo "Examples"
   echo
   echo "git review mybranch"
   echo "git review -a"
}

while getopts ":ah" OPTION; do
    case $OPTION in
    a)
        PUSH_OPTION="%m=#AS,l=Code-Review+2"
        ;;
    ?)
        usage
        exit 0
        ;;
    h)
        usage
        exit 0
        ;;
    *)
        echo "Incorrect options provided"
        exit 1
        ;;
    esac
done

shift $((OPTIND-1))

if [ -z "$1" ]
then
  UPSTREAM=$(git rev-parse --abbrev-ref --symbolic-full-name @{u}) || exit 1
  TARGET_BRANCH=${UPSTREAM#*/}
  REPOSITORY=${UPSTREAM%/*}
else
  TARGET_BRANCH=$1
  REPOSITORY="origin"
fi

echo "Push review for $REPOSITORY/$TARGET_BRANCH"

git push $REPOSITORY HEAD:refs/for/$TARGET_BRANCH$PUSH_OPTION
